# 复制成 .env 后填入你自己的 key（.env 已在 .gitignore 里，不会被提交）
# 渠道按 prio 顺序自动降级：某个渠道余额/额度用尽会切下一个

# 1) OpenCode Zen（Go 套餐，deepseek-v4.1-flash，实测最快）
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4.1-flash

# 2) 日日新 SenseNova
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_MODEL=deepseek-v4-flash

# 3) 智谱 BigModel（GLM）
BIGMODEL_API_KEY=
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
BIGMODEL_MODEL=glm-5.3-flash

# 4) DeepSeek 直连
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 闸二终审用的独立模型（Anthropic messages 协议，与生成不同源）
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_REVIEW_MODEL=agnes-2.0-flash

PORT=4321
